@model IEnumerable<Employee>

<h1>Employees</h1>
<a asp-action="Create" asp-controller="Employees">Create</a>
<ul>
	@foreach (Employee item in Model)
		{
            <li>@item.FirstName @item.LastName 
				<a asp-controller="Employees" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
				<a asp-controller="Employees" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
				</li>
		}
</ul>